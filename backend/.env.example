# Copy to .env and fill in. Never commit the real .env.

# ── Core ──────────────────────────────────────────────────
DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Email (enrollment welcome mail) ───────────────────────
# For Gmail: enable 2-Step Verification on the account, then create an
# "App Password" (Google Account > Security > App passwords) and use that
# 16-character value as SMTP_PASSWORD. Your normal Gmail password will not work.
# If these are left blank the app still runs; welcome emails are just skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=your-account@gmail.com
EMAIL_FROM_NAME=Cambfordable
# Used to build the "Go to my dashboard" link in emails.
FRONTEND_URL=http://localhost:3000

# ── WhatsApp (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── JazzCash ──────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_PAYMENT_URL=
JAZZCASH_RETURN_URL=

# ── Zoom ──────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ── Redis (live chat and live questions) ──────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Optional ──────────────────────────────────────────────
# Comma-separated extra frontend origins allowed by CORS.
FRONTEND_ORIGINS=
# Set to true locally to serve /docs; leave unset on Railway.
ENABLE_API_DOCS=
# Set to true to stop the hourly billing job (reminders, pauses, removals).
BILLING_JOB_DISABLED=
